#<?php exit;?>

[auth]
auth_providers = [
  { class = "FileCarton\\StaticPasswordAuth" },
  { class = "FileCarton\\GitHubOAuth", client_id = "__GITHUB_CLIENT_ID__", client_secret = "__GITHUB_CLIENT_SECRET__" }
]
grant_resolvers = [
  { file = "/opt/filecarton/demo_grant.php", class = "FileCartonDemo\\SharedFolderGrant" }
]
static_user_list = [
  { id = "demo", display_name = "Demo", password_hash = "__PASSWORD_HASH__" }
]
motd = { file = "/opt/filecarton/motd.md" }

[repo]
# verifyAllSet() requires these four. A partial [repo] table replaces the
# built-in default instead of merging with it, so feature flags are explicit.
root_path = "/data/demo"
readonly = false
branding = "FileCarton"
repo_name = "Demo"
temp_dir = "/data/tmp"
feature_archive = true
feature_unix_perm = false
feature_unix_perm_modify = false
feature_remote_download = false
feature_checksum = true
feature_copy_link = false
theme_primary = ""
theme_toolbar = "sky-solid"

[limits]
upload_chunk_size = "8M"
upload_max_file_size = "256M"

[deployment]
public_origin = "__PUBLIC_ORIGIN__"

[misc]
analytics = """
<!-- Matomo -->
<script>
  var _paq = window._paq = window._paq || [];
  /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (function() {
    var u="https://analytics.zbx1425.cn/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '2']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
  })();
</script>
<!-- End Matomo Code -->
"""
