# Copy this file to tests/.env.local and point the keys at this machine.
# tests/.env.local is gitignored. The PHP app does not read it.

# Required when the tools are not on PATH. Absolute paths.
PHP_EXE=C:\php\php.exe
PHP_CGI=C:\php\php-cgi.exe
CADDY=C:\tools\caddy.exe

# Optional. Empty means: use the php.ini next to PHP_EXE, plus -d overrides
# from the rig (upload limits, session.save_path, error log).
PHP_INI=

# FastCGI worker count. Each php-cgi process handles one request at a time.
FC_WORKERS=4

# Bind address for Caddy and the workers. Keep this on loopback.
FC_BIND=127.0.0.1
